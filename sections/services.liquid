<style>
.placeholder-svg {
    width: 500px;
    height: 500px;
}

.image{
    object-fit: cover;
    border-radius: 30px;
    height: auto;
   
   
}



.card_container{
    background-color: #f6f3ee;
    padding: 15px;
    border-radius: 30px;
    display: flex;
    flex-direction: column;
    justify-content: space-between; /* Ensures content is evenly spaced */
    height: 100%; 
    margin-bottom: 30px;
}

.service_description {
    flex-grow: 1; /* Pushes the button down */
}

.button-color{
    background-color: #800017;
 
    
}
.button{
    box-shadow: none !important;
}
.subheading{
    text-align: center;
}

.services_container{
    margin-top: 50px;
    margin-bottom: 50px;
}

.image-container {
    position: relative; /* Makes it a positioned parent */
    display: inline-block;
    width: 100%;
}

.price {
    position: absolute;
    top: 10px;
    right: 10px;
    background-color: rgba(0, 0, 0, 0.7); /* Adds a semi-transparent background */
    color: white;
    padding: 5px 10px;
    border-radius: 10px;
    font-weight: bold;
}



@media only screen and (min-width: 600px){
 .services_container{
    display: flex;
   flex-direction: column;
   align-items: center;
}

.services {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 40px;
   
   
}


}

@media screen and (min-width: 1024px) and (max-width: 1440px){

.services{
    grid-template-columns: 1fr 1fr;
}



}


</style>
<div class="services_container page-width">
    <div>
    <h1>{{ section.settings.services_heading }}</h1>
    </div>  
  
        <div class="services">
        {% for block in section.blocks %}
            <div class="card_container">
           <div class="image-container">
            {% if block.settings.service_image != blank %}
                <img src="{{ block.settings.service_image | img_url: '500x500' }}" width="500" height="480" alt="Service Image" class="image">
            {% else %}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
        {% endif %}
        <p class="price">{{ block.settings.price }}</p>

        </div>
          
           
              
            <div>
                <h3>{{ block.settings.service_offered }}</h3>
            </div>
            <div>
                <p>
                    {{ block.settings.service_description }}
                </p>
            </div>
            <div>
                <button class="button button-color">Learn More</button>
            </div>
        </div>
            {% endfor %}

        </div>

</div>





{%  schema  %}

{
    "name": "Services",
    "settings": [
    {
        "type": "richtext",
        "label": "Heading",
        "id": "services_heading",
        "default":"<p>Our Services</p>"

    }
    
],

"blocks": [
    
    {
       "type": "service",
       "name":"services",

       "settings": [
        {
        "type": "image_picker",
        "id": "service_image",
        "label": "Service Image"
       },
       {
        "type": "richtext",
        "id": "price",
        "label": "Service Price",
        "default": "<p>From R250</p>"

       },
       {
        "type": "richtext",
        "id": "service_offered",
        "label": "Service",
        "default":"<p>Service</p>"
       },
       {
        "type": "richtext",
        "id": "service_description",
        "label": "Service Description"
       }
    ]
    }
],


"presets": [
    {
        "name": "Services"
    }
]

}


{% endschema %} 